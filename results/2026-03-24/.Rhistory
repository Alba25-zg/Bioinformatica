taxa_total <- fromJSON(paste0(API, "taxonomy/uniprot/"))
num_taxa_total <- taxa_total$count
taxa_protein <- fromJSON(paste0(API, "taxonomy/uniprot/protein/"))
num_taxa_protein <- taxa_protein$count
taxa_sin_proteina <- num_taxa_total - num_taxa_protein
cat("1. Número de taxones sin proteína asignada:", taxa_sin_proteina, "\n")
prot_total <- fromJSON(paste0(API, "protein/"))
num_prot_total <- prot_total$count
prot_structure <- fromJSON(paste0(API, "protein/structure/"))
num_prot_structure <- prot_structure$count
proporcion <- num_prot_structure / num_prot_total
porcentaje <- proporcion * 100
cat("2. Proporción de proteínas con estructura:", proporcion,
"(que es un", round(porcentaje, 2), "% del total)\n")
> proporcion <- num_prot_structure / num_prot_total
proporcion <- num_prot_structure / num_prot_total
porcentaje <- proporcion * 100
